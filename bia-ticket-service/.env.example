# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.

# --- Where tickets come from -------------------------------------------------
# The BIA ticket API endpoint (get_tickets_statuses) and its key.
# Use a NEW, rotated key: the old one is exposed in the BIA team report skill.
BIA_API_URL=https://your-bia-host/ticket_api/get_tickets_statuses
BIA_API_KEY=replace-with-rotated-read-only-key

# Optional: BIA tag that marks Engineering / Server tickets (blank = all tickets).
BIA_FILTER_TAG=

# Offline mode: read tickets from a JSON file instead of the API (great for testing).
# BIA_TICKETS_FILE=tests/fixtures/tickets_sample.json

# --- Rules -------------------------------------------------------------------
# Match these to BIA's real status labels (run `python -m bia_service report` and check by_status).
DONE_STATUSES=completed,closed,resolved,done,cancelled
ACTIVE_STATUSES=in progress,working,started,in-progress
# Active tickets with no update for this many days are flagged "idle".
IDLE_DAYS=3
# Reuse fetched tickets for this many seconds before calling BIA again.
CACHE_SECONDS=900
TIMEZONE=Asia/Kolkata

# --- Files -------------------------------------------------------------------
LEAD_MAP_FILE=config/lead_map.json
SNAPSHOT_DB=data/snapshots.db

# --- GitLab: code activity from merge requests (optional) -------------------
# Read-only. Create a token in GitLab (Preferences > Access tokens) with ONLY the read_api scope,
# ideally from a dedicated service account that is a Reporter on the group.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# Group id (number) or path (e.g. my-company/engineering). Covers all projects and subgroups.
GITLAB_GROUP=
# How a ticket number looks in an MR title or branch name. MUST match BIA's real format.
# Default matches T-1234, BIA-123 and #1234.
# TICKET_REGEX=(?i)(?:\b[a-z]{1,5}-\d+\b|#\d+)
# An open MR nobody has commented on after this many hours counts as "waiting for review".
REVIEW_WAIT_HOURS=24
MR_DAYS=14
MR_FETCH_DAYS=30
# Offline testing: raw GitLab MR records in a JSON file instead of the API.
# GITLAB_MRS_FILE=tests/fixtures/mrs_sample.json

# --- HTTP mode only (hosting) ------------------------------------------------
# Long random string; every request except /health must send "Authorization: Bearer <token>".
SERVICE_TOKEN=
# The domain the server is reached on, e.g. tickets-mcp.yourdomain.com
ALLOWED_HOSTS=
